---
# Bandit Security Scanner Configuration
# https://bandit.readthedocs.io/en/latest/config.html
#
# Viatique Security Policy:
# - Production code: Strict scanning (all checks enabled)
# - Test code: Scanned but with known false positives suppressed via nosec
# - Management commands: Scanned with env var validation enforced

# Directories to exclude from scanning
exclude_dirs:
  - .venv
  - venv
  - staticfiles
  - __pycache__
  - migrations
  - .pytest_cache
  - tests
