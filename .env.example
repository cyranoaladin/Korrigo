# Django Settings
DJANGO_SETTINGS_MODULE=core.settings_prod

# Django Security
# CRITICAL: Generate a real key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_COMMAND_ABOVE
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# Database (Postgres) — either DATABASE_URL or individual DB_* vars
# DATABASE_URL takes priority if set (e.g. postgres://user:pass@host:5432/dbname)
DATABASE_URL=
DB_NAME=viatique
DB_USER=viatique_user
DB_PASSWORD=change_this_password_in_prod
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Security / reverse proxy
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Redis (required in production for sessions, cache, rate limiting, Celery)
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=1

# Admin bootstrap (used by ensure_admin management command)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_in_prod
ADMIN_EMAIL=admin@example.com

# Student access control
# Set to 'true' to block new student logins (maintenance mode)
STUDENT_ACCESS_BLOCKED=false

# Rate limiting (set to 'false' to disable, only in dev/E2E)
RATELIMIT_ENABLE=true
E2E_TEST_MODE=false

# Optional app settings
SSL_ENABLED=false
E2E_SEED_TOKEN=

# Prometheus metrics endpoint token (leave empty to disable token auth in dev)
# In production, set to a random secret to protect /metrics
METRICS_TOKEN=

# CORS/CSRF (if frontend is separate domain)
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
