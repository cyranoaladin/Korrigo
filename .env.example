# ═══════════════════════════════════════════════════════════════
# Korrigo — Production Environment Variables
# Copy to .env and fill all required values before deploying.
# ═══════════════════════════════════════════════════════════════

# === OBLIGATOIRE EN PRODUCTION ===
# Générer avec: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DJANGO_ENV=production
DEBUG=False
SSL_ENABLED=True
DJANGO_AUTO_MIGRATE=false
SEED_ON_START=false
ENABLE_API_DOCS=false
GUNICORN_WORKERS=4

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=korrigo.labomaths.tn,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://korrigo.labomaths.tn
CSRF_TRUSTED_ORIGINS=https://korrigo.labomaths.tn

# === Base de données (PostgreSQL) ===
POSTGRES_DB=korrigo_db
POSTGRES_USER=korrigo_user
POSTGRES_PASSWORD=           # Mot de passe fort obligatoire

# === Redis ===
REDIS_HOST=redis
REDIS_PASSWORD=             # Mot de passe fort obligatoire (Redis requirepass)
REDIS_DB=1

# === Monitoring ===
METRICS_TOKEN=               # OBLIGATOIRE en prod — Token pour /metrics (lève une erreur si absent)

# === LLM / Bilans — optionnel (requis pour générer un bilan) ===
# Fournisseur 1: OpenAI (utilisé pour l'OCR Vision et les bilans)
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Modèle Vision OCR (optionnel)
OPENAI_MODEL=
#
# Fournisseur 2: Gateway OpenAI-compatible (ex: Cloudflare Workers AI)
AI_PROVIDER_URL=
AI_PROVIDER_KEY=
# Exemple: @cf/moonshotai/kimi-k2.6
AI_MODEL_NAME=
#
# Bilan (LLM + RAG)
BILAN_LLM_DEFAULT=
BILAN_LLM_PREMIUM=
# Si vide: défaut = true en production (fail-closed)
BILAN_REQUIRE_RAG=
RAG_URL=
RAG_TOKEN=
# Doit être routable depuis le backend sans attacher Korrigo à un réseau hors périmètre.

# === Backup chiffrement (GPG) ===
# Obligatoire en prod : dumps DB, exports JSON et archives media chiffrés GPG AES256
# La passphrase doit être stockée hors du serveur (gestionnaire de secrets)
BACKUP_GPG_PASSPHRASE=
REQUIRE_BACKUP_GPG=true

# === Docker / CI ===
KORRIGO_BACKEND_IMAGE=ghcr.io/cyranoaladin/korrigo-backend@sha256:aafe75e7e4bc475f066ed57cc4b16dc816ea3497c70f3e8e954c5ba496929e1e
KORRIGO_NGINX_IMAGE=ghcr.io/cyranoaladin/korrigo-nginx@sha256:5c4dda163f3ce4a4ff7e4a2b321adafb398cc3cdaa4461d708de89dabae0f61a
KORRIGO_SHA=korrigo-step3-20260620-1958681

# === Mots de passe initiaux (provisionnement) ===
# Aucun mot de passe initial élève ne doit être fourni au runtime backend/celery.
# Si une commande explicite d'import/seed le nécessite, passer DEFAULT_PASSWORD
# uniquement dans l'environnement de cette commande one-shot, puis le retirer.
# ADMIN_PASSWORD et TEACHER_PASSWORD ne doivent pas être fournis au runtime prod.

# === Rate-limit élèves ===
# Limite applicative par identifiant tenté (évite de pénaliser un NAT d'établissement).
STUDENT_LOGIN_RATE_LIMIT_ATTEMPTS=10
STUDENT_LOGIN_RATE_LIMIT_WINDOW=900

# === Email (notifications d'erreur) — optionnel ===
# ADMIN_EMAIL=admin@labomaths.tn
# EMAIL_HOST=smtp.labomaths.tn
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# SERVER_EMAIL=korrigo@labomaths.tn

# === Sentry (observabilité) — optionnel ===
# SENTRY_DSN=
