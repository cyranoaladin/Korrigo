# Production Environment Variables Template
# CRITICAL: All values MUST be changed before deployment
# Copy this file to .env and set real production values

# Django Configuration
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE_THIS_TO_RANDOM_50_CHAR_STRING
DJANGO_ENV=production
DEBUG=False
DJANGO_AUTO_MIGRATE=false
SEED_ON_START=false
ENABLE_API_DOCS=false

# ALLOWED_HOSTS: Comma-separated list of hostnames/IPs Django will accept
# CRITICAL: Must be set in production (application won't start if empty)
# SECURITY: Wildcard (*) is blocked in production by validation logic
# 
# Examples:
#   Single domain:        DJANGO_ALLOWED_HOSTS=korrigo.education.fr
#   Domain + www:         DJANGO_ALLOWED_HOSTS=korrigo.education.fr,www.korrigo.education.fr
#   Multiple subdomains:  DJANGO_ALLOWED_HOSTS=app.example.com,api.example.com
#   With IP (staging):    DJANGO_ALLOWED_HOSTS=staging.example.com,192.168.1.100
#   Behind load balancer: DJANGO_ALLOWED_HOSTS=example.com,10.0.1.50
#
# NOTE: In settings_prod.py, this variable is named DJANGO_ALLOWED_HOSTS (not ALLOWED_HOSTS)
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# Database Configuration
DB_NAME=korrigo_prod
DB_USER=korrigo_user
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Redis AUTH (required by production compose)
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_THIS_TO_STRONG_REDIS_PASSWORD
REDIS_DB=1

# Security Settings
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
SSL_ENABLED=true

# Rate Limiting
RATELIMIT_ENABLE=true

# Prometheus metrics endpoint protection (REQUIRED in production — app won't start if missing)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_TOKEN=CHANGE_THIS_TO_RANDOM_TOKEN

# Backup encryption (required in production)
# PostgreSQL dumps, JSON exports and media archives must be encrypted with GPG AES256.
# Store this passphrase outside Git and outside operational chat logs.
BACKUP_GPG_PASSPHRASE=CHANGE_THIS_TO_STRONG_GPG_PASSPHRASE
REQUIRE_BACKUP_GPG=true

# LLM / Ollama configuration (optional — defaults shown)
# OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=llama3.2:latest
# OLLAMA_TIMEOUT=300

# Gunicorn binding (optional — defaults shown)
# GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=4

# Logging
DJANGO_LOG_LEVEL=INFO

# Email Configuration (for error notifications)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=CHANGE_THIS
ADMINS=admin@example.com

# CORS Configuration
# Comma-separated list of origins allowed to make cross-origin requests
CORS_ALLOWED_ORIGINS=https://your-domain.com

# CSRF Trusted Origins
# CRITICAL: Must match your frontend origin(s) in production
# Required for CSRF protection when using separate frontend domain
# Format: https://domain (include protocol, no trailing slash)
# Examples:
#   Single domain:   CSRF_TRUSTED_ORIGINS=https://korrigo.education.fr
#   Multiple:        CSRF_TRUSTED_ORIGINS=https://korrigo.education.fr,https://www.korrigo.education.fr
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Media Storage (if using S3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=

# GitHub Container Registry (for image pulls)
KORRIGO_BACKEND_IMAGE=ghcr.io/cyranoaladin/korrigo-backend@sha256:a8bb49dd22b00238160e1ccec26732de89d2ac8cbc13526e1131e5793a5ae893
KORRIGO_NGINX_IMAGE=ghcr.io/cyranoaladin/korrigo-nginx@sha256:ecf71a4ed705ab3cb72121edc27030294a8d81eceeb2635a8e2beb45e84bf8a4
KORRIGO_SHA=korrigo-step3-20260620-2715fd5
